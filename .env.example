# Database
DATABASE_URL=postgresql://rateshopper:password@localhost:5432/rateshopper

# Scraper
SCRAPER_CONCURRENCY=3
SCRAPER_TIMEOUT_MS=30000
SCRAPER_DELAY_MIN_MS=2000
SCRAPER_DELAY_MAX_MS=5000

# Scheduler (cron expressions)
REFRESH_SCHEDULE_1=0 6 * * *
REFRESH_SCHEDULE_2=0 14 * * *
REFRESH_SCHEDULE_3=0 22 * * *

# Rate Settings
PARITY_THRESHOLD_PCT=2
LOOK_AHEAD_DAYS=1,3,7,14,30,60,90
BASE_CURRENCY=THB

# SerpAPI
SERPAPI_API_KEY=your_serpapi_key_here

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
